<?xml version="1.0" encoding="utf-8"?>
<animation-list xmlns:android="http://schemas.android.com/apk/res/android" android:oneshot="false">
    <item android:duration="3000">
        <shape>
            <gradient
                android:startColor="#0F4C81"
                android:endColor="#0A2540"
                android:angle="0" />
        </shape>
    </item>
    <item android:duration="3000">
        <shape>
            <gradient
                android:startColor="#0A2540"
                android:endColor="#0F4C81"
                android:angle="90" />
        </shape>
    </item>
    <item android:duration="3000">
        <shape>
            <gradient
                android:startColor="#0F4C81"
                android:endColor="#0A2540"
                android:angle="180" />
        </shape>
    </item>
    <item android:duration="3000">
        <shape>
            <gradient
                android:startColor="#0A2540"
                android:endColor="#0F4C81"
                android:angle="270" />
        </shape>
    </item>
</animation-list>