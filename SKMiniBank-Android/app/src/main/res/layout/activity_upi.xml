<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fino_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fino_primary"
        app:title="UPI Management"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Red Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/fino_primary"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="60dp"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My UPI Details"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Securely manage your UPI ID and PIN"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardUpiInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-40dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YOUR ACTIVE UPI ID"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/fino_text_secondary"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tvUpiId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/fino_text_primary"
                        android:layout_marginTop="12dp"/>

                    <TextView
                        android:id="@+id/tvUpiStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIVE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/fino_accent_green"
                        android:background="@drawable/badge_approved"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateUpi"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="32dp"
                        android:text="CREATE UPI ID"
                        android:backgroundTint="@color/fino_primary"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="28dp"
                        android:visibility="visible"/>

                    <!-- PIN & OTP Section - Always Visible -->
                    <LinearLayout
                        android:id="@+id/layoutSetPin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="20dp"
                        android:visibility="visible">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilOtp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter 4-Digit OTP"
                            android:visibility="visible"
                            app:startIconDrawable="@android:drawable/ic_dialog_info"
                            app:startIconTint="@color/fino_primary"
                            app:boxStrokeColor="@color/fino_primary"
                            app:hintTextColor="@color/fino_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etOtp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="4"
                                android:gravity="center"
                                android:textSize="18sp"
                                android:textColor="@color/fino_text_primary"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilNewPin"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="Create New 4-Digit PIN"
                            android:visibility="visible"
                            app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                            app:startIconTint="@color/fino_primary"
                            app:passwordToggleEnabled="true"
                            app:boxStrokeColor="@color/fino_primary"
                            app:hintTextColor="@color/fino_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUpiPin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberPassword"
                                android:maxLength="4"
                                android:letterSpacing="1"
                                android:gravity="center"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/fino_text_primary"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSetPin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp"
                            android:text="VERIFY AND SET PIN"
                            android:textStyle="bold"
                            android:visibility="visible"
                            app:backgroundTint="@color/fino_primary"
                            app:cornerRadius="28dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Always keep your UPI PIN secret. Do not share it with anyone."
                android:textSize="12sp"
                android:textColor="@color/fino_text_secondary"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:gravity="center"
                android:paddingHorizontal="32dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>