<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fino_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fino_primary"
        app:title="Manage Debit Card"
        app:titleTextColor="@color/white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Realistic Premium Virtual Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="210dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@android:color/transparent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/premium_card_bg"
                    android:padding="24dp">

                    <!-- Bank Name and Type -->
                    <TextView
                        android:id="@+id/tvBankName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SK MINI PAYMENT BANK"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/tvBankName"
                        android:text="PREMIUM DEBIT"
                        android:textColor="#B3FFFFFF"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"/>

                    <!-- Logo -->
                    <ImageView
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/sk_logo"
                        android:alpha="0.9"
                        android:contentDescription="Bank Logo"/>

                    <!-- Chip -->
                    <View
                        android:id="@+id/cardChip"
                        android:layout_width="45dp"
                        android:layout_height="35dp"
                        android:layout_centerVertical="true"
                        android:background="@drawable/card_chip"/>

                    <!-- Contactless Icon (using a simple visual) -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_toEndOf="@id/cardChip"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:src="@android:drawable/ic_lock_idle_low_battery"
                        android:rotation="90"
                        app:tint="#80FFFFFF"
                        android:alpha="0.6"/>

                    <!-- Card Number -->
                    <TextView
                        android:id="@+id/tvDisplayCardNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/cardChip"
                        android:layout_marginTop="20dp"
                        android:text="5421  8800  1234  5678"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.1"
                        android:shadowColor="#80000000"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:shadowRadius="2"/>

                    <!-- Holder Name -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CARD HOLDER"
                            android:textColor="#80FFFFFF"
                            android:textSize="8sp"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:id="@+id/tvDisplayCardName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAJID KHAN"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:letterSpacing="0.05"/>
                    </LinearLayout>

                    <!-- Expiry -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VALID THRU"
                            android:textColor="#80FFFFFF"
                            android:textSize="8sp"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:id="@+id/tvDisplayExpiry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12/28"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <!-- Network Logo (VISA/Mastercard) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:text="VISA"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold|italic"
                        android:alpha="0.9"/>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>


            <!-- Card Controls -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Card Controls"
                android:textColor="@color/fino_text_primary"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temporary Block"
                            android:textColor="@color/fino_text_primary"
                            android:textSize="15sp"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchBlock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Online Transactions"
                            android:textColor="@color/fino_text_primary"
                            android:textSize="15sp"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchOnline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:checked="true"/>
                    </RelativeLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contactless (NFC)"
                            android:textColor="@color/fino_text_primary"
                            android:textSize="15sp"/>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchNfc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetPin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="CHANGE CARD PIN"
                android:textStyle="bold"
                app:backgroundTint="@color/fino_primary"
                app:cornerRadius="28dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestNew"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="REQUEST REPLACEMENT"
                android:textColor="@color/fino_primary"
                app:strokeColor="@color/fino_primary"
                app:cornerRadius="28dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>